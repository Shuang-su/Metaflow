{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metaflow.shuang-su.com/schemas/completion-manifest-1.0.json",
  "title": "Metaflow Completion Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "changeId",
    "terminalState",
    "risk",
    "components",
    "request",
    "plan",
    "agentSummary",
    "taskRecords",
    "closure",
    "dossier",
    "redactions",
    "generatedAt"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "changeId": {
      "type": "string",
      "pattern": "^MF-(?:[1-9][0-9]*|T0-[0-9]{8}-[a-z0-9]+(?:-[a-z0-9]+)*)$"
    },
    "terminalState": {
      "enum": [
        "observed",
        "proposed",
        "accepted",
        "specified",
        "planned",
        "implementing",
        "verifying",
        "ready-for-release",
        "released",
        "observing",
        "closing",
        "closed",
        "rejected",
        "parked",
        "superseded",
        "rolled-back"
      ]
    },
    "risk": {"enum": ["T0", "T1", "T2", "T3"]},
    "components": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["viewer", "editor", "design", "data", "platform", "reference"]}
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "messageCount"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "messageCount": {"type": "integer", "minimum": 1}
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "revision", "source"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "revision": {"type": "integer", "minimum": 1},
        "source": {"type": "string", "minLength": 1}
      }
    },
    "agentSummary": {"$ref": "#/$defs/contentRef"},
    "taskRecords": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["taskId", "tool", "sourceTaskId", "status", "record", "sha256"],
        "properties": {
          "taskId": {
            "type": "string",
            "pattern": "^MF-(?:[1-9][0-9]*|T0-[0-9]{8}-[a-z0-9]+(?:-[a-z0-9]+)*)-T[0-9]{2}$"
          },
          "tool": {"type": "string", "minLength": 1},
          "sourceTaskId": {"type": ["string", "null"]},
          "status": {"enum": ["complete", "partial", "blocked", "failed", "cancelled"]},
          "record": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "closure": {"$ref": "#/$defs/contentRef"},
    "dossier": {"$ref": "#/$defs/contentRef"},
    "redactions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["location", "reason", "replacement"],
        "properties": {
          "location": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "replacement": {"type": "string", "pattern": "^\\[REDACTED: .+\\]$"}
        }
      }
    },
    "generatedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "contentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
