{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metaflow.shuang-su.com/schemas/ci-routing-1.0.json",
  "title": "Metaflow CI routing manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "checks", "routes"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "checks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "docs",
          "governance",
          "viewer",
          "editor",
          "design",
          "data",
          "reference",
          "release",
          "codeql",
          "dependency-review"
        ]
      }
    },
    "routes": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "includePaths", "excludePaths", "checks"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "category": {
            "enum": [
              "docs",
              "governance",
              "dependency",
              "viewer",
              "editor",
              "data",
              "design",
              "reference",
              "release"
            ]
          },
          "includePaths": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "excludePaths": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
