      },
      {
        "major": 3,
        "name": "Walk mode, voxel collision, mobile controls, and first-person controls"
      },
      {
        "major": 4,
        "name": "Animation policy, synthetic figure-eight, and ACG resource publishing"
      },
      {
        "major": 5,
        "name": "SuperSplat v1.26.2–v1.29.1 architecture, tiled collision, on-demand rendering, capture, localization, debugging, and Metaflow compatibility"
      }
    ]
  },
