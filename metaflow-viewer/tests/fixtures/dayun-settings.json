  "cameras": [
    {
      "initial": {
        // 初始相机位置，格式是 [x, y, z]。
        // 如果想让开场镜头更远，就沿着“position 相对 target 的方向”继续往外拉。
        "position": [
          -694.823644,
          166.774502,
          -0.769584
        ],

        // 相机看向的目标点，格式是 [x, y, z]。
        // 如果你觉得场景中心不对，一般先改这里。
        "target": [
          -359.567177,
          -51.547946,
          -127.010187
        ],

        // 视角大小，单位是度。
        // 数值越大，画面越广；数值越小，画面越像放大。
        "fov": 75
      }
    }
  ],

  // 标注热点。没有就保持空数组。
  "annotations": [],

  // 启动模式。
  // default：普通打开
  // animTrack：启动后自动播放第一条动画
  // annotation：从标注/热点流程开始
  "startMode": "animTrack"
}
