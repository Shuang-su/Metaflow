{
  // SuperSplat viewer 配置版本，保持为 2。
  "version": 2,

  // 色调映射模式。
  // 可选值：none、linear、filmic、hejl、aces、aces2、neutral
  "tonemapping": "neutral",

  // 大场景建议保持 true，避免精度问题。
  "highPrecisionRendering": true,

  "background": {
    // 背景纯色兜底，RGB，取值范围 0 到 1。
    // 如果下面配置了 gradient，实际显示会优先用渐变。
    "color": [
      0.9,
      0.95,
      0.99
    ],

    // 背景渐变，目的是把远处黑色接缝藏进“天空色”里。
    // topColor：顶部颜色
    // horizonColor：地平线附近颜色
    // bottomColor：底部颜色
    // horizonStop：地平线颜色出现的位置，0 到 1
    // bottomStop：底部颜色结束的位置，0 到 1
    "gradient": {
      "topColor": [
        0.5,
        0.72,
        0.94
      ],
      "horizonColor": [
        0.93,
        0.96,
        0.99
      ],
      "bottomColor": [
        0.82,
        0.87,
        0.92
      ],
      "horizonStop": 0.62,
      "bottomStop": 1
    }
  },
  "postEffectSettings": {
    "sharpness": {
      // 锐化。想让画面更“脆”一点时可以打开。
      "enabled": false,
      "amount": 0
    },
    "bloom": {
      // 泛光。亮部会有发光感。
      "enabled": false,
      "intensity": 1,
      "blurLevel": 2
    },
    "grading": {
      // 全局调色。
      "enabled": false,
      "brightness": 0,
      "contrast": 1,
      "saturation": 1,
      "tint": [
        1,
        1,
        1
      ]
    },
    "vignette": {
      // 暗角。屏幕边缘会压暗。
      "enabled": false,
      "intensity": 0.5,
      "inner": 0.3,
      "outer": 0.75,
      "curvature": 1
    },
    "fringing": {
      // 色差效果。
      "enabled": false,
      "intensity": 0.5
    }
  },

