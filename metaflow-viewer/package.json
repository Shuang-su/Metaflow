{
  "name": "metaflow-viewer",
  "version": "5.11.0",
  "description": "Gaussian Splatting Viewer for metaflow.shuang-su.com",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./settings": {
      "types": "./dist/settings.d.ts",
      "import": "./dist/settings.js"
    }
  },
  "dependencies": {
    "posthog-js": "^1.386.8",
    "rrweb": "^2.0.1"
  },
  "devDependencies": {
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.0",
    "autoprefixer": "10.5.0",
    "concurrently": "9.2.1",
    "playcanvas": "2.19.2",
    "postcss": "8.5.15",
    "rollup": "4.61.0",
    "rollup-plugin-copy": "3.5.0",
    "rollup-plugin-scss": "4.0.1",
    "rollup-plugin-string": "3.0.0",
    "sass": "1.100.0",
    "serve": "14.2.6",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build": "rollup -c",
    "develop": "concurrently --kill-others \"npm run watch\" \"npm run serve\"",
    "serve": "serve public -l 3000",
    "start": "npm run serve",
    "test": "node --test tests/*.mjs",
    "type:check": "tsc --noEmit",
    "watch": "rollup -c -w"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
