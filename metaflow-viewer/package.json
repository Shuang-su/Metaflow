  "type": "module",
  "devDependencies": {
    "@playcanvas/web-components": "0.3.0",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.0",
    "autoprefixer": "10.4.23",
    "concurrently": "9.2.1",
    "playcanvas": "2.15.2",
    "postcss": "8.5.6",
    "rollup": "4.56.0",
    "rollup-plugin-copy": "3.5.0",
    "rollup-plugin-scss": "4.0.1",
