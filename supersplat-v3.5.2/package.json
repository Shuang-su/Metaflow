{
    "name": "supersplat",
    "version": "3.9.2",
    "author": "PlayCanvas<support@playcanvas.com>",
    "homepage": "https://playcanvas.com/supersplat/editor",
    "description": "3D Gaussian Splat Editor",
    "keywords": [
        "playcanvas",
        "ply",
        "gaussian",
        "splat",
        "editor"
    ],
    "license": "MIT",
    "main": "index.js",
    "scripts": {
        "build": "rollup -c",
        "watch": "rollup -c -w",
        "serve": "serve dist -C",
        "develop": "cross-env BUILD_TYPE=debug concurrently --kill-others \"npm run watch\" \"npm run serve\"",
        "develop:auto-launch": "concurrently --kill-others \"xdg-open 'http://localhost:3000/'\" \"npm run watch\" \"npm run serve\"",
        "lint": "eslint src",
        "lint:locales": "node scripts/check-locales.mjs",
        "test": "tsc -p test/tsconfig.json && node --import ./test/register.mjs test/queue-ordering.mjs && node --test tests/*.test.mjs",
        "test:e2e": "playwright test",
        "type:check": "tsc --noEmit",
        "prebuild": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\""
    },
    "engines": {
        "node": ">=22.13.0 <23"
    },
    "devDependencies": {
        "@playcanvas/eslint-config": "3.0.0",
        "@playcanvas/pcui": "6.2.0",
        "@playcanvas/splat-transform": "3.12.0",
        "@playcanvas/supersplat-viewer": "1.26.3",
        "@playwright/test": "1.62.1",
        "@rollup/plugin-alias": "6.0.1",
        "@rollup/plugin-image": "3.0.3",
        "@rollup/plugin-json": "6.1.0",
        "@rollup/plugin-node-resolve": "16.0.3",
        "@rollup/plugin-terser": "1.0.2",
        "@rollup/plugin-typescript": "12.3.1",
        "@types/wicg-file-system-access": "2023.10.7",
        "@typescript-eslint/eslint-plugin": "8.71.0",
        "@typescript-eslint/parser": "8.71.0",
        "@webgpu/types": "0.1.74",
        "autoprefixer": "10.6.2",
        "concurrently": "10.0.7",
        "cross-env": "10.1.0",
        "eslint": "10.14.0",
        "eslint-import-resolver-typescript": "4.4.5",
        "globals": "17.13.0",
        "i18next": "27.1.1",
        "i18next-browser-languagedetector": "8.3.0",
        "i18next-http-backend": "4.0.10",
        "mediabunny": "1.65.2",
        "playcanvas": "2.24.2",
        "postcss": "8.5.32",
        "rollup": "4.68.2",
        "rollup-plugin-scss": "4.0.1",
        "sass": "1.108.2",
        "serve": "14.2.7",
        "tslib": "2.9.1",
        "typescript": "6.0.3",
        "prettier": "3.10.1"
    },
    "type": "module"
}
